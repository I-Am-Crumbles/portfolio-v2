---
import Base from '../layouts/Base.astro';
import { sections } from '../data/sections';
import { url } from '../data/url';
---
<Base>
  <h1>Everyone has a blog, bud.</h1>
  <p>
    I'm Crumbles (Matt in real life), a cybersecurity professional documenting what I learn:
    web app security, hardware hacking, a home lab, and photography.
  </p>
  <ul class="cards">
    {sections.map((s) => (
      <li class="card">
        <a href={url(`/${s.slug}/`)}>{s.title}</a>
        <p>{s.blurb}</p>
      </li>
    ))}
  </ul>
</Base>
