---
import { sections } from '../data/sections';
import { url } from '../data/url';
interface Props { title?: string }
const { title } = Astro.props;
const pageTitle = title ? `${title} · Crumbles` : 'Crumbles · Security & Photography Portfolio';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={url('/favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site">
      <a class="brand" href={url('/')}>Crumbles</a>
      <nav>
        {sections.map((s) => <a href={url(`/${s.slug}/`)}>{s.title}</a>)}
        <a href={url('/about/')}>About</a>
        <a href={url('/resume/')}>Resume</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site">© {new Date().getFullYear()} Matthew Crum</footer>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light dark;
    --bg: #fff; --fg: #1c1e21; --muted: #667085; --line: #e4e7ec; --accent: #0b6e4f; --code: #f4f5f7;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0f1214; --fg: #e6e8ea; --muted: #98a2b3; --line: #262b30; --accent: #4cc38a; --code: #171b1e; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--fg); font: 17px/1.65 system-ui, -apple-system, 'Segoe UI', sans-serif; }
  a { color: var(--accent); }
  header.site, footer.site { max-width: 60rem; margin: 0 auto; padding: 1.25rem 1.25rem; display: flex; flex-wrap: wrap; gap: 0.75rem 1.5rem; align-items: baseline; justify-content: space-between; }
  header.site { border-bottom: 1px solid var(--line); }
  footer.site { color: var(--muted); font-size: 0.9rem; border-top: 1px solid var(--line); margin-top: 3rem; }
  .brand { font-weight: 700; font-size: 1.2rem; color: var(--fg); text-decoration: none; }
  header.site nav { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; }
  header.site nav a { color: var(--fg); text-decoration: none; }
  header.site nav a:hover { color: var(--accent); }
  main { max-width: 46rem; margin: 0 auto; padding: 2rem 1.25rem; }
  h1 { line-height: 1.2; margin-top: 0; }
  .cards { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr)); padding: 0; list-style: none; }
  .card { border: 1px solid var(--line); border-radius: 10px; padding: 1rem 1.1rem; }
  .card a { text-decoration: none; font-weight: 600; font-size: 1.05rem; }
  .card p { margin: 0.3rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .soon { opacity: 0.6; }
  .crumbs { color: var(--muted); font-size: 0.9rem; margin-bottom: 1rem; }
  .post-list { list-style: none; padding: 0; }
  .post-list li { display: flex; gap: 1rem; padding: 0.45rem 0; border-bottom: 1px solid var(--line); }
  .post-list time { color: var(--muted); font-variant-numeric: tabular-nums; min-width: 6.5rem; }
  article img { max-width: 100%; height: auto; border-radius: 4px; }
  article pre { overflow-x: auto; padding: 0.9rem; background: var(--code); border-radius: 6px; font-size: 0.9rem; }
  article code { background: var(--code); padding: 0.1em 0.3em; border-radius: 4px; font-size: 0.92em; }
  article pre code { background: none; padding: 0; }
  article table { display: block; overflow-x: auto; border-collapse: collapse; }
  article th, article td { border: 1px solid var(--line); padding: 0.35rem 0.6rem; }
</style>
